# Signaling server URL (Google Cloud)
SIGNALING_URL=wss://signaling.yourdomain.com

# Tracker URLs (comma-separated)
TRACKER_URLS=wss://tracker.yourdomain.com/tracker,wss://tracker.openwebtorrent.com

# Chunk cache directory
CHUNK_CACHE_DIR=./chunks

# Maximum chunks to cache
MAX_CACHED_CHUNKS=20

# Download timeout (ms)
DOWNLOAD_TIMEOUT=10000

# Enable debug logging
ENABLE_DEBUG_LOGGING=false
