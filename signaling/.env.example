# WebSocket port (Cloud Run sets PORT automatically)
WS_PORT=8080

# HTTPS WebSocket port
WSS_PORT=8443

# Enable HTTPS (disabled on Cloud Run)
ENABLE_HTTPS=false

# SSL certificate paths (not used on Cloud Run)
CERT_PATH=../certificates/origin.pem
KEY_PATH=../certificates/origin-key.pem

# Maximum manifest chunks
MAX_MANIFEST_CHUNKS=20

# Enable debug logging
ENABLE_DEBUG_LOGGING=false
